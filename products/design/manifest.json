{
  "name": "design",
  "version": "0.1.0",
  "requires": [
    "core",
    "hq"
  ],
  "commands": [
    ".claude/commands/arc-design-critique.md"
  ],
  "agents": [
    ".claude/agents/design-critic.md",
    ".claude/agents/design-director.md",
    ".claude/agents/design-jury.md",
    ".claude/agents/ui-composer.md"
  ],
  "scripts": [
    ".claude/scripts/design/composer-scope-check.sh",
    ".claude/scripts/design/critic-scope-check.sh",
    ".claude/scripts/design/design-critique.sh",
    ".claude/scripts/design/design-explore.sh",
    ".claude/scripts/design/design-gate.sh",
    ".claude/scripts/design/design-lint.mjs",
    ".claude/scripts/design/design-render.sh"
  ],
  "files": [
    ".claude/hooks/PreToolUse-edit.d/10-design-critic.sh",
    ".claude/hooks/PreToolUse-read.d/10-design-composer.sh"
  ],
  "docs": [
    {
      "src": "docs/templates/design-brief-template.md",
      "dest": "docs/templates/design-brief-template.md"
    },
    {
      "src": "docs/templates/design-library-entry-template.md",
      "dest": "docs/templates/design-library-entry-template.md"
    }
  ],
  "face": {
    "room": "design-studio",
    "ring": "factory",
    "kinds": [
      "decision.recorded",
      "note.logged",
      "review.completed"
    ],
    "sanctioned": [
      "docs/design/**",
      ".claude/state/design",
      "review.completed{lens: design}"
    ],
    "stations": [
      "canonical tokens",
      "critique",
      "explore",
      "jury",
      "render"
    ],
    "concepts": [
      "BELOW-BAR",
      "blind jury / reference item",
      "deterministic render",
      "thesis (design)",
      "tokens.css"
    ]
  }
}

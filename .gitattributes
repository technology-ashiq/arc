# Cross-platform line-ending policy (PLAN pre-mortem #6: Windows breakage).
# Shell scripts, bats tests, and YAML MUST be LF on checkout everywhere, or
# bash on Linux CI chokes on carriage returns. Authored on Windows Git Bash,
# executed on ubuntu CI -- LF is non-negotiable for anything a shell runs.
* text=auto eol=lf

*.sh    text eol=lf
*.bash  text eol=lf
*.bats  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Evidence bundles are sha256-hash-pinned (ADR-0002): git must NOT rewrite their
# bytes (line endings included) or tamper-verification breaks on checkout across
# platforms. Freeze them exactly as hashed -- this OVERRIDES `* text=auto eol=lf`.
docs/evidence/** -text

# Byte-exact hostile fixture for product-lint (Phase 00): the crlf-bom case tests
# BOM + CR rejection -- git must NOT normalize its bytes or the fixture silently
# stops testing what it claims. OVERRIDES `* text=auto eol=lf`.
tests/fixtures/products/hostile/crlf-bom/** -text

# Cycle 2 Phase 00: the spine's hostile corpus attacks the emitter at the BYTE level --
# CRLF, BOM, invalid UTF-8, raw control characters. Normalizing any of it would leave the
# fixture green while testing nothing. OVERRIDES `* text=auto eol=lf`.
tests/fixtures/spine/hostile/** -text

# Binary assets: never touch.
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# The CRLF hostile fixture IS its bytes: the design-lint suite pins that a Windows-authored
# (CRLF) brief lints identically. Any eol conversion on add or checkout kills the pin.
tests/fixtures/design-lint/hostile/crlf.md -text

# Same reasoning, whole directory: develop-lint's adversarial fixtures are byte-level attacks.
# Two of them ARE their line endings, and git warned it would rewrite them on the next touch --
# which would have left the CRLF and mixed-ending cases byte-identical to the LF ones on CI,
# so the suite would have gone on reporting them CAUGHT while testing nothing.
tests/fixtures/develop/breaking/** -text

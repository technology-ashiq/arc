{
  "note": "Armed fixture (ADR-0905). Prose only, no code. A model that types every change `feat` or `chore` fails here, and nothing else in the set catches that. Input is {} because commit-msg-draft declares inputs: [] -- the varying thing is repo_state, materialized by the harness (M3).",
  "repo_state": "docs-only",
  "input": {},
  "expected": {
    "commits": [
      {
        "sha": "4936371",
        "subject": "docs(readme): document what total does with non-array input"
      }
    ]
  },
  "assertions": [
    {
      "id": "A-01",
      "path": "commits.0.sha",
      "op": "matches",
      "value": "^[0-9a-f]{7,40}$"
    },
    {
      "id": "A-02",
      "path": "commits.0.subject",
      "op": "matches",
      "value": "^(feat|fix|chore|docs|refactor|test|perf)(\\([a-z0-9-]+\\))?: .+"
    },
    {
      "id": "A-03",
      "path": "commits.0.subject",
      "op": "matches",
      "value": "^docs"
    },
    {
      "id": "A-04",
      "path": "commits.0.subject",
      "op": "length_between",
      "value": [
        12,
        72
      ]
    },
    {
      "id": "A-05",
      "path": "commits.0.subject",
      "op": "matches",
      "value": "[^.]$"
    },
    {
      "id": "A-06",
      "path": "commits.1",
      "op": "absent"
    }
  ]
}

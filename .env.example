# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# ===== Database: Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ===== Payments: Stripe =====
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Analytics =====
NEXT_PUBLIC_ANALYTICS_ID=

# ===== Optional MCPs (only if you enable them in .mcp.json) =====
SENTRY_AUTH_TOKEN=
GITHUB_PAT=

# ===== arc-council cross-model juror (v3) =====
# Any OpenAI-compatible provider works — set base URL + model + key (free tiers fine).
# Examples: Groq  https://api.groq.com/openai/v1            (model: llama-3.3-70b-versatile)
#           Gemini https://generativelanguage.googleapis.com/v1beta/openai  (model: gemini-2.0-flash)
#           OpenRouter https://openrouter.ai/api/v1          (model: deepseek/deepseek-chat-v3-0324:free)
#           DeepSeek https://api.deepseek.com                (model: deepseek-chat)
# Unset = deep runs proceed with "Juror: unavailable (not configured)" (offline-first, ADR-0016).
JUROR_BASE_URL=
JUROR_MODEL=
JUROR_API_KEY=
# Optional: per-attempt timeout in ms (default 60000)
JUROR_TIMEOUT_MS=

# Second provider — used to prove the env-only provider switch (REQ-03); the runner maps JUROR2_* → JUROR_*
JUROR2_BASE_URL=
JUROR2_MODEL=
JUROR2_API_KEY=

# ===== leads: outgoing mail (ADR-0415 mailer · ADR-0416 rehearsal) =====
# One vendor, two policy layers. Unset = both paths refuse to send, loudly (never a silent no-op).
RESEND_API_KEY=
# The From address. Must be on a domain verified in Resend.
ARC_LEADS_MAIL_FROM=
#
# TWO SEPARATE ALLOWLISTS, ON PURPOSE — do not merge them.
# Comma-separated addresses. A recipient absent from the relevant list is refused in code,
# before any network call. This is what makes the product domain safe to send from at all.
#
#   MAIL      = who arc may NOTIFY (deploy failures, waiting approvals, daily brief).
#               The owner only. A rehearsal recipient here would start receiving canary alerts.
#   REHEARSAL = the ADR-0416 rehearsal recipients. Known/consenting people only.
#               The owner's own address here would make him a valid cold-rehearsal target.
ARC_LEADS_MAIL_ALLOWLIST=
ARC_LEADS_REHEARSAL_ALLOWLIST=
#
# NOT declared here as keys, deliberately, and the reason is worth writing down because the
# omission looks like an oversight from either direction:
#
#   ARC_LEADS_MAIL_BASE_URL  redirects the vendor endpoint, which means it redirects the
#                            `Authorization: Bearer <key>` header to a host of its choosing.
#                            It is a TEST door with a safe default, so declaring it as a key
#                            would make `/arc-toolcheck` demand a value for it — and this file
#                            is exactly where an attacker-supplied value would be most welcome.
#                            `arc-leads mail` refuses it outright when it arrives from
#                            `.env.local`, alongside ARC_LEADS_FAKE, ARC_LEADS_NOW,
#                            ARC_LEADS_STORE and LEADS_FIXTURE_DIR.
#
# The rule this encodes: `.env.local` carries CREDENTIALS. Variables that decide whether a send
# is real, when "today" is, where the store lives, or which host receives the key are not
# credentials, and a credential file is read too late for the startup guard to see them.


# --- engine drivers -------------------------------------------------------------
# The generic-api driver has read these four since engine Cycle 6 and this file has
# never documented them, so the whole credential contract of a shipped driver was
# undiscoverable from the env contract. Recorded here in Cycle 7 (ADR-0211).
# ARC_LLM_ENDPOINT is an OpenRouter/LiteLLM-shaped chat-completion URL.
ARC_LLM_ENDPOINT=
ARC_LLM_API_KEY=
ARC_LLM_MODEL=
ARC_LLM_TIMEOUT_MS=

# The agent-runtime driver credential (ADR-0211/0213). A CAPPED key: its ceiling is a
# recorded human decision and it is the termination lever, because revoking it stops
# dispatch instantly. Never an uncapped key. Not needed until certification fixtures 4
# and 10 -- Phases 04 through 06 run at zero spend against a local model endpoint.
#
# MEASURED 2026-08-16, correcting ADR-0213 as written: a spent PER-KEY limit returns
# HTTP 403 "Key limit exceeded (total limit)", not 402. 402 is what an ACCOUNT out of
# credits returns, and this design uses a per-key limit. A `:free` model still answers
# HTTP 200 on a zero-limit key, which is what makes the zero-spend path real.
ARC_HERMES_API_KEY=

# The digest-pinned runtime image. A tag is refused: Phase 04 measured `:latest` moving to a
# different build on the same day the pinned digest stood still.
ARC_HERMES_IMAGE=

# THE RUNTIME HOME, AND IT IS A TEMPLATE RATHER THAN A WORKSPACE (ADR-0222).
#
# It is READ and copied, never mounted. Each dispatch runs against its own private copy, made
# just before the container starts and removed after it exits. That is not tidiness: the
# runtime's built-in memory CANNOT be turned off -- `hermes memory --help` says
# "Built-in memory (MEMORY.md/USER.md) is always active" -- and a marker planted in one run was
# measured afterwards on disk in BOTH memories/MEMORY.md and state.db. Mounting one directory
# across dispatches carries content from one context pack into the next WITHOUT it travelling as
# a pack, so REQ-06's boundary check never sees it.
#
# Cost of the copy: 2,235 ms for 36 MB / 1,171 files, against a 145-400s cold boot for an empty
# volume. Seed the template once; every dispatch after that is warm.
ARC_HERMES_DATA=

# EGRESS CONFINEMENT, AND IT IS OPT-IN, WHICH MEANS UNSET = UNCONFINED (Phase 06 fixture 7).
# Measured: with default networking the container reaches ANY host -- curl https://example.com
# returned 200. `--network none` and an `--internal` bridge both block everything INCLUDING the
# model endpoint, so neither works alone. What works is an allowlisting proxy on an internal
# network: .claude/scripts/engine/egress-proxy.py, run inside the same pinned image.
# Set BOTH or neither -- a proxy without a network is unrestricted egress wearing the appearance
# of a control, and the driver refuses that combination.
ARC_HERMES_NETWORK=
ARC_HERMES_PROXY=

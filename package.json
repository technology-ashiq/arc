{
  "name": "arc",
  "version": "0.2.0",
  "description": "arc: tracked plans, deterministic gates, a receipt spine and agent workflows, installable into a project for Claude Code, Codex, OpenCode or any agentskills reader.",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "arc": "bin/arc.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "node .claude/scripts/core/gate-parity.mjs && node .claude/scripts/core/brain-drift.mjs && node .claude/scripts/engine/arc-compile.mjs --check --all --input source --target opencode",
    "test": "node .claude/scripts/review/ci-digest.mjs --wait --timeout-min 9",
    "lint:js": "node tools/lint/node_modules/eslint/bin/eslint.js --config tools/lint/eslint.config.mjs .",
    "test:local": "node --test --test-reporter=tap \"tests/**/*.test.mjs\" && node .claude/scripts/core/ci-floor.mjs",
    "test:changed": "node .claude/scripts/core/test-changed.mjs",
    "test:bats": "node .claude/scripts/core/test-changed.mjs --all",
    "ci": "node .claude/scripts/core/test-changed.mjs --ci",
    "ci:status": "node .claude/scripts/review/ci-digest.mjs --wait --timeout-min 9"
  },
  "files": [
    "bin/",
    ".claude/",
    "!.claude/settings.local.json",
    "!.claude/state/",
    "!.claude/worktrees/",
    "!.claude/scheduled_tasks.lock",
    "!.claude/arc-registry.json",
    "!.claude/.headroom_wrap_*",
    "engine/",
    "products/",
    "docs/templates/",
    "docs/playbooks/",
    "docs/blueprint.md",
    "docs/how-it-works.md",
    "docs/build-playbook.md",
    "docs/product-runbook.md",
    "docs/plugins.md",
    "docs/usermanual.md",
    "docs/council/README.md",
    "docs/council/references/fairness.md",
    "CONSTITUTION.md",
    "sync-to-project.sh"
  ],
  "dependencies": {}
}
